---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileStickyCTA from '../components/MobileStickyCTA.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  keywords?: string[];
  jsonLd?: Record<string, unknown>[];
  showMobileCTA?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  keywords,
  jsonLd,
  showMobileCTA = false,
} = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      keywords={keywords}
      jsonLd={jsonLd}
    />
  </head>
  <body
    class:list={[
      'min-h-screen flex flex-col bg-surface text-ink antialiased',
      (showMobileCTA || Astro.slots.has('mobile-cta')) && 'pb-[4.5rem] md:pb-0',
    ]}
  >
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-white"
    >
      ข้ามไปเนื้อหาหลัก
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    {showMobileCTA ? <MobileStickyCTA /> : <slot name="mobile-cta" />}

    <script is:inline>
      document.addEventListener('click', function(event) {
        const cta = event.target.closest('[data-track-cta]');
        if (!cta) return;

        const eventName = cta.getAttribute('data-track-cta');
        const ctaLocation = cta.getAttribute('data-cta-location') || '';
        const productGroup = cta.getAttribute('data-product-group') || '';
        const pageType = cta.getAttribute('data-page-type') || '';
        const ctaType = cta.getAttribute('data-cta-type') || '';
        const pagePath = window.location.pathname;

        const trackingData = {
          page_path: pagePath,
          cta_location: ctaLocation,
          product_group: productGroup,
          page_type: pageType,
          cta_type: ctaType
        };

        // GTM dataLayer
        if (window.dataLayer && typeof window.dataLayer.push === 'function') {
          try {
            window.dataLayer.push({
              event: eventName,
              ...trackingData
            });
          } catch (e) {
            console.warn('dataLayer push failed:', e);
          }
        }

        // GA4 gtag
        if (typeof window.gtag === 'function') {
          try {
            window.gtag('event', eventName, trackingData);
          } catch (e) {
            console.warn('gtag call failed:', e);
          }
        }
      });
    </script>
  </body>
</html>
