---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTAButton from '../components/CTAButton.astro';
import { SITE, getLineOALink } from '../config/site';
import { MAP_EMBED, MAP_URL } from '../config/home-hub';
import { areaNav, infoNav, serviceNav } from '../config/navigation';
import { areasIndex, contactPage, faqPage, pricingPage, servicesIndex, updatesIndex } from '../config/urls';
import { buildBreadcrumbSchema } from '../lib/breadcrumbs';
import { buildLocalBusinessSchema } from '../lib/schema';
import OwnerPhoto from '../components/OwnerPhoto.astro';

const pageTitle = 'ติดต่อเรา / ประเมินราคาด่วน | รับซื้ออุบล.com';
const pageDescription =
  'ติดต่อรับซื้ออุบล.com เพื่อประเมินราคาฟรี แอด LINE @buyhub หรือดูบริการรับซื้อ-รับเทิร์นไอทีในอุบลราชธานี';

const breadcrumbItems = [{ label: 'หน้าแรก', href: '/' }, { label: 'ติดต่อเรา' }];

const jsonLd = [buildBreadcrumbSchema(breadcrumbItems), buildLocalBusinessSchema()];
const lineLink = getLineOALink();
const mapUrl = MAP_URL;
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={contactPage()} jsonLd={jsonLd} showMobileCTA>
  <div class="py-12 sm:py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <Breadcrumbs items={breadcrumbItems} />
      <h1 class="mt-6 text-2xl font-extrabold text-ink sm:text-3xl">ติดต่อเรา / ประเมินราคาด่วน</h1>
      <p class="mt-4 text-lg text-muted">{pageDescription}</p>

      <div class="mt-8 rounded-3xl overflow-hidden border border-line">
        <OwnerPhoto id="storefront" thumbnail />
      </div>

      <div class="mt-10 rounded-2xl bg-gradient-to-r from-brand to-brand-dark p-8 text-center text-white">
        <h2 class="text-xl font-bold">ช่องทางที่เร็วที่สุด — LINE</h2>
        <p class="mt-2 text-white/85">ตอบ LINE {SITE.lineHours} · ส่งรูปประเมินราคาเบื้องต้นฟรี</p>
        <p class="mt-2 text-sm text-white/85">{SITE.estimateNote}</p>
        <div class="mt-5">
          <CTAButton href={lineLink} label="แอด LINE @buyhub ประเมินราคาฟรี" />
        </div>
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <div class="rounded-2xl border border-line p-5">
          <h2 class="font-bold text-ink">ข้อมูลติดต่อ</h2>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            <li>
              <strong class="text-ink">LINE OA:</strong>{' '}
              <a
                href={lineLink}
                target="_blank"
                rel="noopener noreferrer"
                class="text-brand hover:underline font-semibold">{SITE.lineOA}</a
              >
            </li>
            <li>
              <strong class="text-ink">โทรศัพท์:</strong>{' '}
              <a href={`tel:${SITE.phone.replace(/-/g, '')}`} class="text-brand hover:underline font-semibold"
                >{SITE.phone}</a
              >
            </li>
            <li><strong class="text-ink">ดำเนินการโดย:</strong> {SITE.businessName}</li>
            <li><strong class="text-ink">บริษัท:</strong> {SITE.companyName}</li>
            <li><strong class="text-ink">พื้นที่ให้บริการ:</strong> อุบลราชธานี สอบถามเงื่อนไขนัดรับต่างอำเภอได้</li>
            <li>
              <strong class="text-ink">อีเมล:</strong>{' '}
              <a href={`mailto:${SITE.email}`} class="text-brand hover:underline">{SITE.email}</a>
            </li>
            <li><strong class="text-ink">หน้าร้าน:</strong> {SITE.storeName}</li>
            <li><strong class="text-ink">ที่อยู่:</strong> {SITE.addressText}</li>
            <li><strong class="text-ink">จุดสังเกต:</strong> {SITE.landmark}</li>
            <li><strong class="text-ink">เวลาเปิดหน้าร้าน:</strong> {SITE.storeHoursLabel}</li>
            <li><strong class="text-ink">เวลาตอบ LINE:</strong> {SITE.lineHours}</li>
          </ul>
          <p class="mt-4 text-sm text-muted">{SITE.visitNote}</p>
          <p class="mt-3"><a href={SITE.facebookUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-brand hover:underline">Facebook ร้านอำพล เทรดดิ้ง →</a></p>
          <a
            href={mapUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex text-sm font-semibold text-brand hover:underline"
          >
            ดูแผนที่บน Google Maps →
          </a>
        </div>
        <div class="rounded-2xl border border-line p-5">
          <h2 class="font-bold text-ink">บริการรับซื้อ</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              serviceNav.map((item) => (
                <li>
                  <a href={item.href} class="text-brand hover:underline">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm">
            <a href={servicesIndex()} class="font-semibold text-brand hover:underline">ดูบริการทั้งหมด →</a>
          </p>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-2xl border border-line shadow-sm">
        <iframe
          src={MAP_EMBED}
          width="100%"
          height="400"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="แผนที่ WINNER IT รับซื้ออุบล.com อุบลราชธานี"
          class="block w-full"></iframe>
      </div>

      <div class="mt-8 rounded-2xl border border-line bg-surface-alt p-5">
        <h2 class="font-bold text-ink">ข้อมูลเพิ่มเติม</h2>
        <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm">
          {
            infoNav.map((item) => (
              <li>
                <a href={item.href} class="text-brand hover:underline">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={updatesIndex()} class="text-brand hover:underline">ผลงานรับซื้อล่าสุด</a>
          </li>
        </ul>
      </div>

      <div class="mt-8">
        <h2 class="font-bold text-ink">พื้นที่ให้บริการในอุบลราชธานี</h2>
        <p class="mt-2 text-sm text-muted">
          <a href={areasIndex()} class="text-brand hover:underline">ดูพื้นที่ให้บริการทั้ง 25 อำเภอ →</a>
        </p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            areaNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-block rounded-full border border-line px-3 py-1.5 text-sm text-muted transition hover:border-brand/30 hover:text-brand"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <article class="prose prose-lg mt-12 max-w-none prose-p:text-muted prose-a:text-brand prose-headings:text-ink">
        <h2>วิธีประเมินราคาผ่าน LINE @buyhub</h2>
        <ol>
          <li>แอด LINE OA <strong>@buyhub</strong> (มี @ นำหน้า)</li>
          <li>ถ่ายรูปสินค้า — หน้าจอ ตัวเครื่องรอบด้าน รอยตำหนิ (ถ้ามี)</li>
          <li>แจ้งรุ่น สเปค และสภาพการใช้งาน</li>
          <li>รับผลประเมินราคาเบื้องต้นหลังตรวจรูปและรายละเอียดสินค้า</li>
          <li>นำสินค้ามาที่ร้าน หรือสอบถามเงื่อนไขนัดรับต่างอำเภอ</li>
          <li>ตรวจสินค้าจริง ยืนยันราคา และรับเงินหลังตกลงซื้อขาย</li>
        </ol>
        <p>
          อ่านรายละเอียดเพิ่มเติมที่ <a href={pricingPage()}>วิธีประเมินราคา</a>
          <a href={faqPage()}>คำถามที่พบบ่อย</a>
          หรือดู <a href={updatesIndex()}>ผลงานรับซื้อล่าสุด</a> เพื่อยืนยันความน่าเชื่อถือ
        </p>
        <h2>ทำไมติดต่อเราผ่าน LINE?</h2>
        <ul>
          <li>ตอบ LINE {SITE.lineHours} — {SITE.estimateNote}</li>
          <li>สะดวก — ส่งรูปได้ทันที ไม่ต้องเดินทาง</li>
          <li>โปร่งใส — แจ้งราคาชัดเจนก่อนนัดรับเสมอ</li>
          <li>ปลอดภัย — นัดรับในที่สาธารณะหรือจุดที่สะดวกทั้งสองฝ่าย</li>
        </ul>
      </article>
    </div>
  </div>
</BaseLayout>
