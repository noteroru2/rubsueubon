---
import { getCollection, render } from 'astro:content';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ConditionsScope from '../../components/ConditionsScope.astro';
import GeoServiceLinks from '../../components/GeoServiceLinks.astro';
import { SITE } from '../../config/site';
import { servicePath, servicesIndex, updatePath, updatesIndex } from '../../config/urls';
import { buildBreadcrumbSchema } from '../../lib/breadcrumbs';
import { getQuickAnswer, mergeFaqs } from '../../lib/service-aeo';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const {
  title,
  description,
  category,
  navLabel,
  geoLinkLabel,
  keywords,
  featuredImage,
  acceptedConditions,
  rejectedConditions,
  faqs,
  tier,
  parentSlug,
  parentLabel,
} = entry.data;

const canonical = servicePath(entry.data.slug);
const ogImage = featuredImage ? new URL(featuredImage, SITE.url).href : `${SITE.url}/og-default.svg`;
const quickAnswer = entry.data.quickAnswer ?? getQuickAnswer(category, entry.id);
const displayFaqs = mergeFaqs(faqs);


const breadcrumbItems =
  (tier === 'brand' || tier === 'series') && parentSlug && parentLabel
    ? [
        { label: 'หน้าแรก', href: '/' },
        { label: 'บริการรับซื้อ', href: servicesIndex() },
        { label: parentLabel, href: servicePath(parentSlug) },
        { label: navLabel },
      ]
    : [{ label: 'หน้าแรก', href: '/' }, { label: 'บริการรับซื้อ', href: servicesIndex() }, { label: navLabel }];

const jsonLd = [
  buildBreadcrumbSchema(breadcrumbItems),
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}${canonical}#webpage`,
    url: `${SITE.url}${canonical}`,
    name: title,
    description,
    inLanguage: 'th-TH',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#localbusiness` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE.url}${canonical}#service`,
    name: title,
    description: description,
    url: `${SITE.url}${canonical}`,
    provider: { '@id': `${SITE.url}/#localbusiness` },
    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'อุบลราชธานี',
    },
  },
];
---

<ServiceLayout
  frontmatter={{ title, description, category, faqs: displayFaqs }}
  canonical={canonical}
  ogImage={ogImage}
  featuredImage={featuredImage}
  keywords={keywords}
  jsonLd={jsonLd}
  quickAnswer={quickAnswer}
  slug={entry.data.slug}
>
  <div class="not-prose mb-8">
    <Breadcrumbs items={breadcrumbItems} />
  </div>
  <Content />

  <div slot="after-content">
    {
      (acceptedConditions.length > 0 || rejectedConditions.length > 0) && (
        <ConditionsScope accepted={acceptedConditions} rejected={rejectedConditions} />
      )
    }
    <GeoServiceLinks serviceLabel={geoLinkLabel} />
  </div>
</ServiceLayout>
