---

<section class="border-y border-line bg-surface py-12 sm:py-16" aria-labelledby="real-computer-repair-work-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-bold text-brand">ภาพจากงานที่หน้าร้าน</p>
      <h2 id="real-computer-repair-work-heading" class="mt-2 text-2xl font-extrabold text-ink sm:text-3xl">
        ตัวอย่างงานซ่อมและอัปเกรดคอม โน้ตบุ๊กจริง
      </h2>
      <p class="mt-4 leading-relaxed text-muted">
        ภาพถ่ายแสดงขั้นตอนตรวจ ถอดประกอบ อัปเกรด และทดสอบหลังงาน เพื่อให้เห็นลักษณะงานจริง
        รายการซ่อมและอุปกรณ์ที่ใช้ต้องตรวจสอบตามรุ่นของแต่ละเครื่อง
      </p>
    </div>

    <div class="mt-10 space-y-12">
      {
        repairCases.map((repairCase) => (
          <section aria-label={repairCase.title}>
            <div class="max-w-3xl">
              <h3 class="text-xl font-bold text-ink">{repairCase.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{repairCase.description}</p>
            </div>
            <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
              {repairCase.images.map((item) => (
                <figure class="overflow-hidden rounded-2xl border border-line bg-surface-alt shadow-sm">
                  <img
                    src={item.src}
                    alt={item.alt}
                    width={item.width}
                    height={item.height}
                    loading="lazy"
                    decoding="async"
                    class="aspect-[3/4] w-full object-cover"
                  />
                  <figcaption class="p-3 text-xs leading-relaxed text-muted sm:p-4">{item.caption}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</section>
