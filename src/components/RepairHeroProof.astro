---
import { repairPath } from '../config/urls';

const proofItems = [
  {
    src: '/images/repairs/mobile-broken-screen-before.webp',
    width: 442,
    height: 590,
    alt: 'มือถือจอแตกและภาพเป็นเส้นก่อนตรวจซ่อมที่ร้านอำพล เทรดดิ้ง อุบล',
    label: 'ก่อนตรวจ',
    caption: 'บันทึกสภาพจอแตกและภาพเป็นเส้นก่อนเริ่มงาน',
  },
  {
    src: '/images/repairs/mobile-internal-repair-process.webp',
    width: 442,
    height: 590,
    alt: 'ช่างเปิดมือถือเพื่อตรวจชุดประกอบภายในระหว่างงานซ่อม',
    label: 'ระหว่างงาน',
    caption: 'เปิดและแยกชุดประกอบเพื่อตรวจจุดที่เกี่ยวข้อง',
  },
  {
    src: '/images/repairs/notebook-display-panel-before.webp',
    width: 442,
    height: 590,
    alt: 'โน้ตบุ๊กเปิดชุดจอระหว่างตรวจซ่อมที่ร้านอำพล เทรดดิ้ง อุบล',
    label: 'ซ่อมชุดจอ',
    caption: 'เปิดกรอบและชุดจอเพื่อตรวจชิ้นส่วนกับจุดเชื่อมต่อ',
  },
  {
    src: '/images/repairs/notebook-ssd-upgrade-open.webp',
    width: 442,
    height: 590,
    alt: 'โน้ตบุ๊กเปิดฝาหลังระหว่างงานอัปเกรด SSD',
    label: 'อัปเกรด SSD',
    caption: 'เปิดฝาหลังและตรวจตำแหน่งอุปกรณ์ก่อนติดตั้ง',
  },
] as const;
---

<section class="mt-10 border-t border-white/15 pt-7" aria-labelledby="repair-proof-heading">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-bold text-emerald-300">ภาพงานจริงจากหน้าร้าน</p>
      <h2 id="repair-proof-heading" class="mt-1 text-xl font-extrabold text-white sm:text-2xl">
        ตัวอย่างงานซ่อมมือถือ คอม และโน้ตบุ๊ก
      </h2>
    </div>
    <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm font-bold">
      <a
        href={`${repairPath('มือถือ-iphone-ipad-อุบล')}#real-repair-work-heading`}
        class="text-emerald-300 hover:text-emerald-200 hover:underline">เคสมือถือ →</a
      >
      <a
        href={`${repairPath('คอม-โน้ตบุ๊ก-อุบล')}#real-computer-repair-work-heading`}
        class="text-emerald-300 hover:text-emerald-200 hover:underline">เคสคอม/โน้ตบุ๊ก →</a
      >
    </div>
  </div>

  <div
    class="-mx-4 mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-3 sm:mx-0 sm:grid sm:grid-cols-4 sm:overflow-visible sm:px-0 sm:pb-0"
  >
    {
      proofItems.map((item, index) => (
        <figure class="min-w-[72%] snap-start overflow-hidden rounded-2xl border border-white/15 bg-white/10 shadow-lg sm:min-w-0">
          <img
            src={item.src}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : undefined}
            decoding="async"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="p-3">
            <strong class="block text-sm text-white">{item.label}</strong>
            <span class="mt-1 block text-xs leading-relaxed text-white/75">{item.caption}</span>
          </figcaption>
        </figure>
      ))
    }
  </div>
  <p class="mt-3 text-xs leading-relaxed text-white/60">
    เลื่อนดูภาพได้บนมือถือ · ผลตรวจ รายการซ่อม และค่าใช้จ่ายของแต่ละเครื่องแตกต่างกัน
  </p>
</section>
