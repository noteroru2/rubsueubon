---
import { getLineOALink } from '../config/site';

interface Props {
  variant?: 'default' | 'phone' | 'ipad' | 'macbook' | 'notebook' | 'camera' | 'pc_parts' | 'game_console' | 'b2b';
}

const { variant = 'default' } = Astro.props;

const lineUrl = getLineOALink();

const pathname = Astro.url.pathname;
let pageType = 'home';
if (pathname === '/') {
  pageType = 'home';
} else if (pathname.startsWith('/บริการ/')) {
  pageType = 'service';
} else if (pathname.startsWith('/พื้นที่/')) {
  pageType = 'area';
} else if (pathname.startsWith('/บทความ/')) {
  pageType = 'blog';
} else if (pathname.startsWith('/ตัวอย่างเคสประเมิน/')) {
  pageType = 'case';
}

const contentMap = {
  default: {
    title: 'ส่งรูปอะไรให้ประเมินราคาเบื้องต้นได้ง่ายขึ้น',
    steps: [
      { text: 'รูปด้านหน้าและด้านหลังสินค้าให้เห็นสภาพโดยรอบชัดเจน', detail: 'ถ่ายในที่แสงสว่างเพียงพอ' },
      { text: 'รูปตำหนิ รอยแตก รอยบุบ หรืออาการผิดปกติ (ถ้ามี)', detail: 'ช่วยให้ประเมินราคาตรงตามสภาพจริงที่สุด' },
      { text: 'รูปรุ่น/สเปก/ความจุ หรือหน้า About/System Info ของเครื่อง', detail: 'เพื่อความถูกต้องของรุ่น' },
      { text: 'รูปอุปกรณ์เสริมที่มี เช่น กล่อง สายชาร์จ อะแดปเตอร์ หรือใบเสร็จ', detail: 'อุปกรณ์ครบมีผลต่อการเพิ่มราคา' },
      { text: 'แจ้งพื้นที่อยู่หรือพิกัดนัดรับ เช่น เมืองอุบล วารินชำราบ ม.อุบล หรืออำเภอใกล้เคียง', detail: 'เพื่อสะดวกในการนัดพบ' }
    ]
  },
  phone: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคามือถือ',
    steps: [
      { text: 'รูปตัวเครื่องด้านหน้า ด้านหลัง และขอบมุมต่างๆ', detail: 'เปิดหน้าจอให้เห็นสภาพการแสดงผล' },
      { text: 'หน้าจอการตั้งค่า: สุขภาพแบตเตอรี่ (Battery Health) และหน้าเกี่ยวกับ (About)', detail: 'แสดงเลขโมเดลและความจุเครื่อง' },
      { text: 'รูปตำหนิ เช่น รอยถลอก รอยเคสกัด จอเบิร์น หรือรอยแตกร้าว', detail: 'เพื่อประเมินราคาอย่างโปร่งใส' },
      { text: 'รูปกล่องและอุปกรณ์เสริม เช่น สายชาร์จแท้ หูฟัง', detail: 'อุปกรณ์เสริมแท้ครบชุดช่วยเพิ่มมูลค่า' },
      { text: 'แจ้งพื้นที่อยู่และพิกัดที่สะดวกนัดรับในอุบลราชธานี', detail: 'สะดวกตรวจเช็คเครื่องหน้างาน' }
    ]
  },
  ipad: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคา iPad',
    steps: [
      { text: 'รูปตัวเครื่องด้านหน้าและฝาหลังแบบเต็มจอ', detail: 'แสดงสภาพขอบจอและตัวเครื่องโดยรวม' },
      { text: 'หน้าจอการตั้งค่าแสดงรุ่น ความจุ และตรวจสอบสถานะ Apple ID', detail: 'ต้องจำรหัสผ่านเพื่อออกจากระบบได้' },
      { text: 'รอยชำรุด เช่น รอยบิ่นตามมุม ฝาหลังงอ หรือจอเหลือง', detail: 'แจ้งสภาพตรงตามจริงเพื่อราคาประเมินที่ถูกต้องแม่นยำ' },
      { text: 'อุปกรณ์เสริมเสริม เช่น Apple Pencil, Smart Keyboard หรือกล่อง', detail: 'ปากกาและคีย์บอร์ดเพิ่มมูลค่ารับซื้อ' },
      { text: 'แจ้งพิกัดนัดเจอที่สะดวกในพื้นที่อุบลราชธานี', detail: 'นัดรับของปลอดภัย' }
    ]
  },
  macbook: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคา MacBook',
    steps: [
      { text: 'รูปตัวเครื่องขณะเปิดใช้งาน และรูปสภาพภายนอกรอบตัวเครื่อง', detail: 'ตรวจเช็คจอภาพและบอดี้เบื้องต้น' },
      { text: 'หน้า ข้อมูลระบบ (System Info): หน้าสเปก (CPU, RAM, SSD) และรอบชาร์จแบตเตอรี่ (Cycle Count)', detail: 'สำคัญต่อการประเมินราคา' },
      { text: 'รูปจุดชำรุด เช่น รอยบุบขอบเครื่อง คีย์บอร์ดเงา จอลอก หรือยางขอบจอเสื่อม', detail: 'ถ่ายรูปมุมที่มีปัญหาเพื่อประเมินตรงสภาพ' },
      { text: 'รูปอุปกรณ์ที่มี เช่น สายชาร์จ อะแดปเตอร์ กล่อง หรือใบเสร็จ', detail: 'สายชาร์จและกล่องช่วยให้ได้ราคาดีขึ้น' },
      { text: 'แจ้งพื้นที่สะดวกรถส่งของนัดเจอในอุบลราชธานี', detail: 'บริการนัดรับสะดวกรวดเร็ว' }
    ]
  },
  notebook: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคาโน้ตบุ๊ก',
    steps: [
      { text: 'รูปหน้าตรงตอนเปิดจอ แป้นพิมพ์ และฝาพับภายนอกตัวเครื่อง', detail: 'แสดงสภาพความสวยงามภายนอก' },
      { text: 'หน้าจอแสดงสเปกเครื่อง (CPU, RAM, การ์ดจอ, HDD/SSD) หรือรูปสติ๊กเกอร์ใต้เครื่อง', detail: 'ระบุรุ่นและสเปกเครื่องอย่างถูกต้อง' },
      { text: 'ตำหนิเด่นชัด เช่น จอมีเส้น จุดเดดพิกเซล รอยร้าว หรือบานพับชำรุด', detail: 'แจ้งก่อนตกลงเพื่อความสบายใจทั้งสองฝ่าย' },
      { text: 'อุปกรณ์ที่มี เช่น อะแดปเตอร์สายชาร์จ กระเป๋า เมาส์ หรือกล่องเดิม', detail: 'สายชาร์จจำเป็นต้องใช้ในการตรวจรับเครื่อง' },
      { text: 'แจ้งอำเภอหรือโซนที่คุณอยู่เพื่อพิจารณานัดพบ', detail: 'ครอบคลุมทุกอำเภอในจังหวัดอุบลราชธานี' }
    ]
  },
  camera: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคากล้องและเลนส์',
    steps: [
      { text: 'รูปบอดี้กล้องรอบตัว หน้าเลนส์ ท้ายเลนส์ และชิ้นเลนส์', detail: 'แสดงความสมบูรณ์ของแก้วเลนส์' },
      { text: 'ข้อมูลจำนวนชัตเตอร์ (Shutter Count) และอายุการใช้งาน', detail: 'ส่งผลต่อราคาประเมินเบื้องต้น' },
      { text: 'ตำหนิ เช่น รอยถลอก ยางบวม รา ฝุ่น หรือฝ้าในเนื้อเลนส์', detail: 'ตรวจสอบสภาพความใสของเลนส์อย่างละเอียด' },
      { text: 'อุปกรณ์ประกอบ เช่น แบตเตอรี่ แท่นชาร์จ สายคล้อง กล่อง ฟิลเตอร์', detail: 'อุปกรณ์เสริมช่วยให้จบราคาได้ดี' },
      { text: 'แจ้งพิกัดในอุบลราชธานีที่สะดวกให้นัดเช็คสภาพเครื่อง', detail: 'ทดสอบการทำงานของระบบโฟกัสและปุ่มกด' }
    ]
  },
  pc_parts: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคาอะไหล่คอมพิวเตอร์',
    steps: [
      { text: 'รูปชิ้นส่วนอุปกรณ์ไอทีเดี่ยวๆ เช่น การ์ดจอ, Mainboard, RAM, CPU', detail: 'ให้เห็นรายละเอียดหน้าหลังชัดเจน' },
      { text: 'ฉลากสติ๊กเกอร์ระบุแบรนด์ รุ่น และรหัสสินค้า (Model / Serial Number)', detail: 'เพื่อเช็คสเปกและเช็คการรับประกันศูนย์' },
      { text: 'ตำหนิ เช่น ซิงก์ขึ้นเกลือ สนิม พัดลมฝืด หรือพอร์ตเชื่อมต่อเสียหาย', detail: 'มีผลต่อการคัดกรองสภาพ' },
      { text: 'กล่องผลิตภัณฑ์และเอกสารประกัน (ถ้ามี)', detail: 'ประกันศูนย์ไทยที่ยังเหลือช่วยเพิ่มราคาได้มาก' },
      { text: 'แจ้งโซนหรือพิกัดจัดส่งในอุบลราชธานี', detail: 'นัดรับตรวจสภาพชิ้นส่วนด่วน' }
    ]
  },
  game_console: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคาเครื่องเกม',
    steps: [
      { text: 'รูปตัวเครื่องเกม PS5, Switch, Steam Deck หรือ Xbox รอบตัว', detail: 'ให้เห็นรอยเปื้อนและสภาพสีผิวบอดี้' },
      { text: 'รูปภาพขณะเปิดเครื่องใช้งาน และหน้าการตั้งค่าเวอร์ชันซอฟต์แวร์', detail: 'ยืนยันระบบทำงานและเชื่อมต่อออนไลน์ได้ปกติ' },
      { text: 'ตำหนิ เช่น อาการจอยดริฟต์ รอยขนแมวขูดขีดบนหน้าจอ หรือพอร์ตชาร์จหลวม', detail: 'ช่วยในการตั้งราคาที่เหมาะสม' },
      { text: 'อุปกรณ์เสริม เช่น จอยคอนโทรลเลอร์ สายต่อพ่วง แผ่นเกม หรือกล่องเดิม', detail: 'ของแถมและแผ่นเกมช่วยเพิ่มมูลค่ารวม' },
      { text: 'แจ้งพิกัดนัดเช็คสภาพสินค้าในอุบลราชธานี', detail: 'สะดวกตรวจเช็คระบบไฟและการเล่นจริง' }
    ]
  },
  b2b: {
    title: 'ส่งรูปอะไรบ้างเพื่อประเมินราคาคอมพิวเตอร์สำนักงานยกล็อต',
    steps: [
      { text: 'รูปถ่ายโดยรวมของกองสินค้า คอมพิวเตอร์ หรือโน้ตบุ๊กยกล็อต', detail: 'ให้เห็นจำนวนและสภาพเครื่องส่วนใหญ่' },
      { text: 'รายการสเปกคอมพิวเตอร์ (Spec Sheet) หรือไฟล์ Excel ระบุรายละเอียด', detail: 'ข้อมูล CPU, RAM, Storage และจำนวนเครื่อง' },
      { text: 'ข้อมูลสภาพการทำงาน เช่น เปิดติดใช้งานได้ปกติ หรือมีเครื่องเสียปะปน', detail: 'แจ้งสภาพความสมบูรณ์เพื่อประเมินราคาได้ใกล้เคียงที่สุด' },
      { text: 'อุปกรณ์เสริมที่มี เช่น จอภาพ คีย์บอร์ด เมาส์ และสายไฟระบบ', detail: 'พิจารณารับซื้อรวมหรือแยกชิ้นตามต้องการ' },
      { text: 'ชื่อผู้ติดต่อ ชื่อบริษัท หรือหน่วยงาน พร้อมเบอร์โทรและพิกัดที่ตั้งสินค้า', detail: 'สะดวกต่อการเสนอราคาและเข้าขนย้ายยกล็อต' }
    ]
  }
};

const current = contentMap[variant] || contentMap.default;
---

<section class="my-10 rounded-2xl border border-line bg-surface p-6 sm:p-8 shadow-sm" aria-labelledby="what-to-send-heading">
  <h2 id="what-to-send-heading" class="text-lg font-bold text-ink sm:text-xl flex items-center gap-2">
    <span class="text-brand">📸</span> {current.title}
  </h2>
  
  <ul class="mt-6 space-y-4">
    {current.steps.map((step, idx) => (
      <li class="flex items-start gap-3">
        <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand/10 text-xs font-bold text-brand mt-0.5">
          {idx + 1}
        </span>
        <div>
          <p class="text-sm font-semibold text-ink leading-normal">{step.text}</p>
          <p class="text-xs text-muted mt-0.5 leading-normal">{step.detail}</p>
        </div>
      </li>
    ))}
  </ul>

  <div class="mt-8 border-t border-line pt-6 text-center">
    <p class="text-xs text-muted mb-4">
      * ข้อมูลและรูปภาพที่ครบถ้วน ช่วยให้ทีมงานประเมินราคาเบื้องต้นได้แม่นยำและจบงานได้รวดเร็วยิ่งขึ้นครับ
    </p>
    <a
      href={lineUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex w-full sm:w-auto items-center justify-center gap-2 rounded-full bg-[#00B900] px-6 py-3 text-sm font-bold text-white shadow-md transition hover:bg-[#009900] active:scale-[0.98] min-h-[44px]"
      aria-label="ส่งข้อมูลประเมินราคาทางไลน์"
      data-track-cta="what_to_send_cta_click"
      data-cta-location="what_to_send"
      data-product-group={variant}
      data-page-type={pageType}
      data-cta-type="line"
    >
      <svg class="h-4.5 w-4.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314" />
      </svg>
      ส่งรูปประเมินราคาทาง LINE
    </a>
  </div>
</section>
