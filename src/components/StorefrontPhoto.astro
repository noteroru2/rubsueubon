---
import { BUSINESS } from '../data/business';
import OwnerPhoto from './OwnerPhoto.astro';

export interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class={compact ? 'mt-5' : 'mt-6'}>
  <OwnerPhoto id="storefront" thumbnail={compact} caption={false} />
  <p class="mt-2 text-center text-xs text-muted">
    หน้าร้าน {BUSINESS.operator} · {BUSINESS.company} · {BUSINESS.province}
  </p>
</div>
