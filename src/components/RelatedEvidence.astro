---
import { getCollection } from 'astro:content';
import { updatePath } from '../config/urls';
import { serviceTopic } from '../lib/service-topics';
import OwnerPhoto from './OwnerPhoto.astro';
interface Props { slug?: string; category?: string; area?: string; }
const { slug = '', category = '', area } = Astro.props;
const topic = serviceTopic(slug, category);
const all = (await getCollection('updates')).sort((a,b) => b.data.pubDate.getTime()-a.data.pubDate.getTime());
const areaKey = (key?: string) => key === 'mueang-ubon' ? 'mueang-ubon-ratchathani' : key;
const matching = all.filter(p => area
  ? p.data.entryKind === 'case' && areaKey(p.data.relatedAreaSlug) === area
  : p.data.topics.includes(topic) || serviceTopic(p.data.relatedServiceSlug) === topic);
const brandTokens = ['sony', 'canon', 'fujifilm', 'asus', 'acer', 'dell', 'iphone', 'ipad', 'samsung', 'oppo', 'macbook', 'insta360'];
const requestedBrands = brandTokens.filter(brand => slug.toLowerCase().includes(brand));
if (!area && requestedBrands.length) {
  const relevance = (title: string) => requestedBrands.filter(brand => title.toLowerCase().includes(brand)).length;
  matching.sort((a,b) => relevance(b.data.title)-relevance(a.data.title) || b.data.pubDate.getTime()-a.data.pubDate.getTime());
}
// Photos are shop evidence, never presented as a transaction in an unverified district.
const posts = matching.length ? matching.slice(0,3) : area ? all.filter(p=>p.data.entryKind==='photo').slice(0,3) : [];
const localCases = area && matching.length > 0;
---
{posts.length > 0 && <section class="border-t border-line bg-surface-alt py-12" aria-label="ภาพสินค้าและผลงานที่เกี่ยวข้อง">
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    <h2 class="text-xl font-bold text-ink sm:text-2xl">{localCases ? 'ผลงานที่เกี่ยวข้องกับพื้นที่นี้' : 'ภาพสินค้าและผลงานที่เกี่ยวข้อง'}</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{area && !localCases ? 'ภาพสินค้าจากร้านอำพล เทรดดิ้งในเมืองอุบล สำหรับดูรายละเอียดก่อนส่งรูปประเมินและตกลงจุดนัดรับในอำเภอของคุณ' : 'ดูภาพสินค้าและรายละเอียดที่เกี่ยวข้อง แล้วส่งรูปสินค้าของคุณเพื่อให้ประเมินตามรุ่นและสภาพจริง'}</p>
    <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {posts.map(post=><li class="rounded-2xl border border-line bg-surface p-4">
        {post.data.photos[0] && <OwnerPhoto id={post.data.photos[0]} thumbnail caption={false} />}
        <p class="mt-3 text-xs font-semibold text-brand">{post.data.entryKind==='photo' ? 'ภาพสินค้าจริงจากร้าน' : 'ผลงานรับซื้อ'}</p>
        <h3 class="mt-2 font-bold text-ink"><a href={updatePath(post.data.slug)} class="hover:text-brand hover:underline">{post.data.title}</a></h3>
        <p class="mt-2 text-sm text-muted">{post.data.description}</p>
      </li>)}
    </ul>
  </div>
</section>}
